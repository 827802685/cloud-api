{
	// 模板：由 `npm run gen:wrangler` 生成 `wrangler.jsonc`（勿手改生成文件）。
	// Gateway Admin（Next.js OpenNext）：Cloudflare 部署仅支持 D1；管理 API 为 `/api/admin/*`（Hono `/admin/*`）。
	// 本地 preview 与 db:migrate 共用 .wrangler/state；远程 deploy 写入 database_id 后须再 npm run gen:wrangler 才能与 migrate 一致。
	// `ADMIN_PASSWORD` 勿写入本文件：本地 `npm run preview` 用 `packages/admin/.dev.vars.example`；生产用 Dashboard Secrets 或 `npx wrangler secret put ADMIN_PASSWORD --name <worker>`。
	"$schema": "./node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "cloud-api-admin",
	"compatibility_date": "2025-11-25",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cloud-api"
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"vars": {
		"ADMIN_USERNAME": "admin",
		// 免费模型 RSS 同步源（可改域名；留空则用代码内置默认值）。
		"RSS_SYNC_URL": "https://rss.zjkl.dpdns.org/rss.xml",
		// Workers AI 智能归类（可选）：REST 通道用 CF_API_TOKEN + CF_ACCOUNT_ID；
		// 或在本文件配置 AI binding（env.AI）。未配置则 RSS 同步降级为启发式归类。
		"CF_API_TOKEN": "",
		"CF_ACCOUNT_ID": "",
		// Admin 无 Next middleware.ts。Workerd 上 getMiddlewareManifest() 的动态 require 会 500；
		// 上游 issue 仍 open 时用 minimal mode 跳过该路径（见 opennextjs-cloudflare#1232）。
		"NEXT_PRIVATE_MINIMAL_MODE": "1",
		// 委托 CPU 密集工具（web-search/fetch/deep-search/ai-detection）给独立 Tools Service。
		// 当前：Render 未部署，主端点直接用 CF Worker mcp-key。
		// 待 Render 部署完成后，把 TOOLS_SERVICE_URL 改回 https://cloud-api-tools.onrender.com，
		// 并把 CF 端点设为 TOOLS_SERVICE_FALLBACK_URL 兜底（自动切换已内置）。
		"TOOLS_SERVICE_URL": "https://mcp.zjkl.dpdns.org",
		// TOOLS_SERVICE_TOKEN / TOOLS_SERVICE_FALLBACK_TOKEN 为敏感令牌，勿写入本文件。
		// 由 GitHub Actions 部署时通过 wrangler-action `secrets` 注入（仓库 Secrets: TOOLS_SERVICE_TOKEN）。
		"TOOLS_SERVICE_FALLBACK_URL": "",
		// 自愈：兜底端点（mcp-key）失败时自动触发 GitHub Actions 重新部署。
		// GH_TOKEN 勿写入本文件（敏感），用 `npx wrangler secret put GH_TOKEN --name cloud-api-admin` 设置。
		"GH_REPO": "827802685/cloud-api",
		"TOOLS_SELF_HEAL_WORKFLOW": "deploy-tools-service.yml",
		"TOOLS_SELF_HEAL_COOLDOWN_MS": "300000"
	}
}
