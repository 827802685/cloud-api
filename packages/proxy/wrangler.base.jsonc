{
	// 模板：由 `npm run gen:wrangler` 生成 `wrangler.jsonc`（勿手改生成文件）。
	// D1 与 Worker 入口。执行 `npm run db:migrate*` 时使用 `packages/core/wrangler.d1.jsonc`（仅 D1，勿 deploy）。
	// 本地 dev：生成文件应无 database_id（`(DB)` 本地库）。远程 deploy 后会写入 database_id — 继续本地 dev 前须再跑 npm run gen:wrangler。
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "cloud-api-proxy",
	"main": "dist/worker.js",
	"compatibility_date": "2025-04-01",
	"compatibility_flags": ["nodejs_compat", "enable_request_signal"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cloud-api"
		}
	],
	"vars": {
		// 委托 CPU 密集工具（web-search/fetch/deep-search/ai-detection）给独立 Tools Service（mcp-key）。
		"TOOLS_SERVICE_URL": "https://mcp.zjkl.dpdns.org",
		"TOOLS_SERVICE_TOKEN": "ecca3ddbb1bc2552e7359bbd88d02df1cd53e7bcae3003b9"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
