# =============================================================================
# OctaFuse Gateway — 公共演示 / 长期测试实例（octafuse.dev）
# =============================================================================
# 文档入口：同目录 README.md · 运维：docs/operators/deployment/cloudflare.md
#
# 本文件即 dev 演示 canonical 配置（可提交 Git）。
# 自有生产环境：复制为 cloudflare-worker/<name>.env（gitignore），部署说明写在对应 env 注释里。
#
# 本地 CLI：
#   npx dotenv -e ./cloudflare-worker/example.env -- npm run db:migrate:remote
#   npx dotenv -e ./cloudflare-worker/example.env -- npm run deploy:proxy
#   npx dotenv -e ./cloudflare-worker/example.env -- npm run deploy:admin
#
# 生产 Git 自动部署见 README §C（dev 演示仅 CLI 发版）
#
# 自定义域名（域名 zone 须在本 Cloudflare 账号）：
#   Proxy   https://api.zjkl.dpdns.org
#   Admin   https://admin.api.zjkl.dpdns.org
#
# 下游用户：
#   GATEWAY_URL=https://api.zjkl.dpdns.org
#   GATEWAY_MASTER_URL=https://admin.api.zjkl.dpdns.org
#   GATEWAY_MASTER_KEY=<D1 system_config.MASTER_KEY>
#
# 首次：npx wrangler d1 create octafuse-gateway-dev → 填入 D1_DATABASE_ID

PROXY_WORKER_NAME=cloud-api-proxy
ADMIN_WORKER_NAME=cloud-api-admin

D1_DATABASE_NAME=cloud-api
D1_DATABASE_ID=3de00849-f0a9-49ea-8cce-062847f53cd8
# 仅 wrangler d1 migrations 配置名；勿 deploy，无需在 Dashboard 建 Worker
D1_MIGRATIONS_WORKER_NAME=cloud-api-d1-migrations

PROXY_CUSTOM_DOMAIN=api.zjkl.dpdns.org
ADMIN_CUSTOM_DOMAIN=admin.api.zjkl.dpdns.org
